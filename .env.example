# EduCompass Backend Environment Variables

# Database Configuration (MySQL)
DB_USERNAME=root
DB_PASSWORD=
DB_URL=jdbc:mysql://localhost:3306/educompass?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JWT Security Configuration
# In production, JWT_SECRET must be a unique, high-entropy 256-bit (32+ chars) secret
JWT_SECRET=c7f8a9e1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9
JWT_EXPIRATION_MS=86400000
JWT_REMEMBER_EXPIRATION_MS=604800000

# Google Authentication (OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID=

# CORS Allowed Origins (comma-separated list of client origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
